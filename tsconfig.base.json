{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@verto/core": ["packages/core/src/index.ts"],
      "@verto/core/*": ["packages/core/src/*"],
      "@verto/config": ["packages/config/src/index.ts"],
      "@verto/config/*": ["packages/config/src/*"],
      "@verto/adapter-github": ["packages/adapters/github/src/index.ts"],
      "@verto/adapter-github/*": ["packages/adapters/github/src/*"],
      "@verto/text-parser": ["packages/text-parser/src/index.ts"],
      "@verto/text-parser/*": ["packages/text-parser/src/*"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false
  }
}
