{
  "name": "verto",
  "displayName": "Verto",
  "description": "Plan and deliver vertical slices from your issue graph using NCN and TOC thinking.",
  "version": "0.0.1",
  "publisher": "manmilani",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Verto",
      "properties": {
        "verto.writeBack.mode": {
          "type": "string",
          "enum": ["draft", "immediate"],
          "enumDescriptions": [
            "Edits collect in a draft; Write back sends them to the tracker.",
            "Each accepted edit is written to the tracker right away."
          ],
          "default": "draft",
          "description": "When edits made in the Verto panel are written to the tracker."
        }
      }
    },
    "commands": [
      {
        "command": "verto.openPanel",
        "title": "Verto: Open Panel"
      },
      {
        "command": "verto.refresh",
        "title": "Verto: Refresh"
      },
      {
        "command": "verto.setup",
        "title": "Verto: Setup"
      }
    ]
  },
  "scripts": {
    "build:host": "node esbuild.mjs",
    "build:webview": "vite build",
    "build": "pnpm build:host && pnpm build:webview",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.webview.json --noEmit"
  },
  "dependencies": {
    "@verto/core": "workspace:*",
    "@verto/config": "workspace:*",
    "@verto/adapter-fissue": "workspace:*",
    "@verto/adapter-github": "workspace:*",
    "@verto/text-parser": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@xyflow/react": "^12.6.4",
    "elkjs": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.96.0",
    "@types/vscode-webview": "^1.57.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@vscode/vsce": "^3.4.2",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  }
}
