{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "node .cursor/hooks/env.js session" }
    ],
    "beforeSubmitPrompt": [
      { "command": "node .cursor/hooks/worktime-hook.js" }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/env.js shell",
        "matcher": "Shell"
      }
    ],
    "postToolUse": [
      { "command": "node .cursor/hooks/worktime-hook.js" }
    ],
    "postToolUseFailure": [
      { "command": "node .cursor/hooks/worktime-hook.js" }
    ],
    "stop": [
      { "command": "node .cursor/hooks/worktime-hook.js" }
    ]
  }
}
