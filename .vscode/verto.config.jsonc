{
  "adapter": "fissue",
  "fissue": {
    "fieldMappings": {
      // Both types listed: an unlisted or empty issueType keeps the default (no parent → vertical).
      "isDeliverySlice": { "from": { "kind": "issue", "field": "issueType" }, "values": { "Vertical": true, "Task": false } },
      "personas": { "from": { "kind": "issueField", "field": "personas" }, "type": "select", "isArray": true },
      "priority": { "from": { "kind": "issueField", "field": "priority" }, "type": "number" }
    }
  },
  "ui": {
    "displayStatusGroups": [
      { "label": "In Progress", "sources": { "ticket": { "statuses": ["In Progress"] } } },
      { "label": "Designed", "sources": { "ticket": { "statuses": ["Designed"] } } },
      { "label": "Raw", "sources": { "ticket": { "statuses": ["Todo"] }, "parsed": { "statuses": ["raw"] } } }
    ]
  }
}
